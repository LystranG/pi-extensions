{
  "name": "@lystran/pi-extensions-workspace",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "validate:packages": "bun scripts/validate-packages.ts",
    "pack:check": "bun scripts/validate-packages.ts --pack",
    "verify": "bun run check && bun run typecheck && bun run test && bun run pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run verify && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "3.0.1",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
